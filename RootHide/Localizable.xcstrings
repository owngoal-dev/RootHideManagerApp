    "Apps are blacklisted by default in current environment, just disable tweaks for this app in the AppList of Bootstrap.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُدرج التطبيقات في القائمة السوداء افتراضيًا في هذه البيئة. عطّل التعديلات لهذا التطبيق في AppList ضمن Bootstrap."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps stehen in dieser Umgebung standardmäßig auf der Blacklist. Deaktivieren Sie die Tweaks für diese App in der AppList von Bootstrap."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps are blacklisted by default in this environment. Disable tweaks for this app in Bootstrap’s AppList."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans cet environnement, les applications sont sur liste noire par défaut. Désactivez les tweaks pour cette application dans l’AppList de Bootstrap."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In questo ambiente le app sono già nella lista nera per impostazione predefinita. Disattiva i tweak per questa app nell’AppList di Bootstrap."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この環境ではアプリは標準でブラックリストに登録されています。Bootstrap の AppList でこのアプリの Tweak を無効にしてください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trong môi trường này, ứng dụng mặc định đã nằm trong danh sách chặn. Hãy tắt tweak cho ứng dụng này trong AppList của Bootstrap."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前环境默认已将应用加入黑名单。请在 Bootstrap 的 AppList 中关闭此应用的插件注入。"
          }
        }
      }
    },
