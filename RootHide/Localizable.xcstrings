    "Review files in specified paths that apps may use to identify a jailbreak. Remove only items you recognize.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "راجع الملفات في المسارات المحددة التي قد تستخدمها التطبيقات لاكتشاف الجيلبريك. لا تُزل إلا الملفات التي تعرف وظيفتها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfen Sie Dateien in festgelegten Pfaden, die Apps als Hinweise auf einen Jailbreak erkennen könnten. Entfernen Sie nur Dateien, deren Zweck Sie kennen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review files in specified paths that apps may use to identify a jailbreak. Remove only items you recognize."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Examinez les fichiers des chemins indiqués que les applications peuvent utiliser pour détecter un jailbreak. Ne supprimez que ceux dont vous connaissez l’usage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla i file nei percorsi indicati che le app potrebbero usare per rilevare un jailbreak. Rimuovi solo quelli di cui conosci la funzione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "指定されたパスにある、アプリが脱獄の判定に使用する可能性があるファイルを確認します。用途を確認してから削除してください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiểm tra các tệp trong đường dẫn chỉ định mà ứng dụng có thể dùng để phát hiện jailbreak. Chỉ xóa tệp khi bạn hiểu rõ mục đích của chúng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查指定路径中可能被 App 识别为越狱特征的文件。请确认用途后再移除。"
          }
        }
      }
    },
